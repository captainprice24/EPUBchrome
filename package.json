{
  "name": "epubchrome",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "playwright test",
    "prepare:assets": "node scripts/assets.mjs",
    "postinstall": "node scripts/assets.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "format": "prettier --write src entrypoints tests scripts/*.mjs *.ts *.json",
    "build:pages": "npm run build && node scripts/package.mjs && vite build --config vite.web.config.ts --mode pages && node scripts/pages-assets.mjs",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "preview:pages": "node scripts/serve.mjs --pages",
    "icons": "node scripts/icons.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "format:check": "prettier --check src entrypoints tests scripts/*.mjs *.ts *.json",
    "lint": "oxlint --max-warnings 8 src entrypoints scripts tests",
    "test:unit": "vitest run",
    "test:extension": "playwright test --config playwright.extension.config.ts"
  },
  "dependencies": {
    "@lingo-reader/mobi-parser": "0.4.6",
    "@noble/hashes": "2.4.0",
    "@zip.js/zip.js": "2.24.0",
    "css-tree": "3.2.1",
    "dexie": "4.4.7",
    "djvu-rs": "0.43.0",
    "dompurify": "3.4.17",
    "entities": "8.1.0",
    "html2canvas": "1.4.1",
    "marked": "18.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "@types/css-tree": "3.2.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.93.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wxt": "0.21.5"
  },
  "description": "A private, local-first EPUB book library with MOBI, PDF, DjVu and Markdown support, annotations and fullscreen reading.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/captainprice24/EPUBchrome.git"
  },
  "homepage": "https://github.com/captainprice24/EPUBchrome#readme",
  "bugs": {
    "url": "https://github.com/captainprice24/EPUBchrome/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
